# Public GitHub issue creation. Never commit the real token.
BUG_REPORT_REPOSITORY=CyprienJ/noscadeaux
BUG_REPORT_TOKEN=github_pat_replace_me
BUG_REPORT_LABELS=bug,source:user-report,status:unconfirmed

# Cloudflare Turnstile (choose the Invisible widget mode in the dashboard).
# Leave both values empty to disable Turnstile in local development.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Production / Nginx Proxy Manager
PUBLIC_BASE_URL=https://noscadeaux.fr
NPM_NETWORK=proxy

# Android TWA: SHA-256 from the Play App Signing certificate.
# Multiple certificate fingerprints can be comma-separated.
TWA_SHA256_FINGERPRINTS=
